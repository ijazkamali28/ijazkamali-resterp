# Copy to .env.docker and change every password.
# Use letters and digits only in passwords (they are placed inside database URLs).
POSTGRES_PASSWORD=change-me-postgres-1
POS_OWNER_PASSWORD=change-me-owner-2
POS_APP_PASSWORD=change-me-app-3

# Your web address, e.g. pos-test.yourcompany.com (its DNS A record must point to this server).
# Leave as :80 to test with plain http://<server-ip> or http://localhost
DOMAIN=:80

# staging = test console enabled + demo data allowed. "production" disables both.
APP_ENV=staging
# Load the demo companies, branches and users on first start (ignored if already loaded)
DEMO_SEED=true
LOG_LEVEL=info
