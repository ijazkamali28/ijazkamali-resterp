# Runtime connection: least-privilege role, subject to row level security
DATABASE_URL=postgres://pos_app:pos_app_dev@localhost:5432/restaurant_pos
# Migration/owner connection: used only by migrate & seed
DATABASE_OWNER_URL=postgres://pos_owner:pos_owner_dev@localhost:5432/restaurant_pos
# Node identity: 'cloud' or 'branch_server' (branch servers also set NODE_BRANCH_CODE)
NODE_TYPE=cloud
NODE_BRANCH_CODE=
PORT=8080
HOST=0.0.0.0
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
LOGIN_RATE_LIMIT_PER_MINUTE=10
